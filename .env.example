# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds your secrets.

# Supabase → Project Settings → API Keys (use the publishable key, never the secret one)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key

# Google AI Studio → https://aistudio.google.com/apikey
# Server-only: never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key

# Optional: override the model set in src/config/ai.ts
# GEMINI_MODEL=gemini-2.5-flash
# Optional: send AI requests through another address (a proxy, or a local stand-in for testing)
# GEMINI_BASE_URL=
